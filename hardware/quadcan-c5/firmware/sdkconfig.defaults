# ESP32-C5-WROOM-1-N8R8
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Console on the native USB Serial/JTAG (UART0 pins go to the LTE header)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Wi-Fi Aware (NAN) - ESP-IDF v6.x option name (v5.x: CONFIG_ESP_WIFI_NAN_ENABLE)
CONFIG_ESP_WIFI_NAN_SYNC_ENABLE=y
CONFIG_LWIP_IPV6=y
# FAT: long file names, fast seeks
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_IMMEDIATE_FSYNC=n
# Higher tick for responsive CAN/GPS tasks
CONFIG_FREERTOS_HZ=1000
